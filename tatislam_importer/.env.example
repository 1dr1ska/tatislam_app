# =============================================================================
# Tatislam Telegram importer — скопируйте в .env и заполните.
# .env НЕ коммитится в Git (см. .gitignore).
# =============================================================================

# Telegram API credentials (https://my.telegram.org/apps).
# Нужны ТОЛЬКО для режима `--source telegram` (по умолчанию).
# Если получить их не удаётся — используйте официальный экспорт Telegram Desktop:
#   python main.py --source export --file /путь/к/result.json
# (режим export не требует API-ключей и авторизации вообще.)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Supabase (база данных): URL проекта и service role key.
# Service role key используется ТОЛЬКО этим серверным инструментом
# (панель окружения Supabase → Settings → API; осторожно с этим ключом).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Yandex Object Storage: те же ключи, что настроены для приложения
# (статические ключи сервисного аккаунта с доступом на запись в бакет).
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=

# --- Необязательные ---

# Канал по умолчанию (можно переопределить через --channel)
TELEGRAM_CHANNEL=

# Файл сессии Telegram (создаётся при первой авторизации)
SESSION_FILE=telegram.session

# Секция Supabase для импортируемых публикаций (по slug из таблицы sections).
# Мәкаләләр: articles; Видео: video; Аудио: audio; Рәсемнәр: rasemnar.
# По умолчанию раздел выбирается по типу публикации:
#   article → DEFAULT_SECTION_SLUG, audio → audio, video → video, photo → rasemnar
DEFAULT_SECTION_SLUG=articles
SECTION_AUDIO_SLUG=audio
SECTION_VIDEO_SLUG=video
SECTION_PHOTO_SLUG=rasemnar

# Статус создаваемых публикаций: published | draft
PUBLICATION_STATUS=published

# Отправлять push-уведомления о новых публикациях (требует настроенную
# Edge Function notify-new-publication и секрет FIREBASE_SERVICE_ACCOUNT_JSON)
PUSH_NOTIFICATIONS_ENABLED=true

# Параметры Yandex Object Storage (по умолчанию совпадают с прод-настройками)
YANDEX_BUCKET=tatislam-media
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_REGION=ru-central1